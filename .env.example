# Docker image tag generated by pipeline
IMAGE_TAG=main-local

# Public host ports
API_PORT=8081
SQL_PORT=14331

# Application environment
ASPNETCORE_ENVIRONMENT=Staging

# Database
SQL_SA_PASSWORD=YourStrong_Password123
CONNECTION_STRING=Server=sqlserver,1433;Database=EnergyESGDb;User Id=sa;Password=YourStrong_Password123;TrustServerCertificate=True

# JWT
JWT_KEY=EnergyESG_SecretKey_Minimum32Characters_ForProduction_ChangeThis
JWT_ISSUER=EnergyESG
JWT_AUDIENCE=EnergyESG
