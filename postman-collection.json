	"item": [
		{
			"name": "Consumos",
			"item": [
				{
					"name": "Listar Consumos",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/consumos?pagina=1&tamanho=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "consumos"],
							"query": [
								{"key": "pagina", "value": "1"},
								{"key": "tamanho", "value": "20"},
								{"key": "unidadeId", "value": "", "disabled": true},
								{"key": "de", "value": "", "disabled": true},
								{"key": "ate", "value": "", "disabled": true}
							]
						}
					}
				},
				{
					"name": "Obter Consumo por ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/consumos/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "consumos", ":id"],
							"variable": [{"key": "id", "value": ""}]
						}
					}
				},
				{
					"name": "Criar Consumo",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"unidadeId\": \"00000000-0000-0000-0000-000000000000\",\n  \"dataHora\": \"2024-01-15T10:00:00Z\",\n  \"kwh\": 100.5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/consumos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "consumos"]
						}
					}
				}
			]
		},
		{
