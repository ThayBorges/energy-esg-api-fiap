								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"unidadeId\": \"00000000-0000-0000-0000-000000000000\",\n  \"limiteKwhHora\": 50.0,\n  \"descricao\": \"Limite de consumo por hora\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/alertas",
							"host": ["{{baseUrl}}"],
							"path": ["api", "alertas"]
						}
					}
				}
