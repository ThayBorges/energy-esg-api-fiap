{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["sensorId", "acao", "status", "dataHora"],
  "properties": {
    "sensorId": { "type": "string", "format": "uuid" },
    "acao": { "type": "string", "enum": ["desligar", "ligar"] },
    "status": { "type": "string" },
    "dataHora": { "type": "string" }
  },
  "additionalProperties": true
}
